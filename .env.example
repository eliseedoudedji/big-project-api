# Port HTTP de l'API
PORT=3000

# Base de données (obligatoire)
# - Local (défaut) : SQLite
#   DATABASE_URL="file:./dev.db"
# - Prod / Neon (recommandé) :
#   DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require"
# - Prod / Render :
#   DATABASE_URL="postgresql://user:password@xxx.render.com:5432/dbname"
DATABASE_URL="file:./dev.db"

# Secret JWT (obligatoire, générer avec une longue chaîne aléatoire)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h

# Origines autorisées (séparées par des virgules)
# Exemples : http://localhost:5173,https://ton-app.onrender.com
CORS_ORIGINS=http://localhost:5173

# "true" uniquement si l'API est derrière un reverse proxy de confiance
TRUST_PROXY=false

# Compte admin créé au premier démarrage
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Clé d'accès du jeu (vérifiée côté serveur)
ACCESS_KEY=O1299

# Avertissements avant bannissement
MAX_STRIKES=3
